{
  "name": "pokedex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "users:list": "node --env-file=.env.local scripts/user-admin.mjs list",
    "users:create": "node --env-file=.env.local scripts/user-admin.mjs create",
    "users:password": "node --env-file=.env.local scripts/user-admin.mjs password",
    "users:delete": "node --env-file=.env.local scripts/user-admin.mjs delete",
    "data:filters": "node scripts/generate-pokemon-filters.mjs",
    "data:encounters": "node scripts/generate-route-encounters.mjs",
    "data:locations": "node scripts/generate-location-names.mjs",
    "data:moves": "node scripts/generate-move-names.mjs",
    "data:versions": "node scripts/generate-version-names.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
