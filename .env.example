# URL pública del sitio. En Vercel normalmente se detecta automáticamente.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# Base de datos Postgres (Neon). En Vercel se rellena al conectar la integración
# de Neon; en local puedes usar `vercel env pull .env.local`.
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require
